<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.lutravox.Ottersnap</id>
  <name>Ottersnap</name>
  <summary>Snapshot image viewer</summary>
  <description>
    <p>
      Ottersnap is a Vulkan-accelerated image viewer that automatically snapshots and tracks version history for images as they change.
      Open an image file and it is watched for changes; every update snapshots the previous state onto a browsable timeline.
    </p>
  </description>
  <launchable type="desktop-id">io.github.lutravox.Ottersnap.desktop</launchable>
  <icon type="stock">io.github.lutravox.Ottersnap</icon>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0+</project_license>
  <url type="homepage">https://github.com/lutravox/ottersnap</url>
  <url type="vcs-browser">https://github.com/lutravox/ottersnap</url>
  <categories>
    <category>Graphics</category>
    <category>Viewer</category>
  </categories>
  <keywords>
    <keyword>image</keyword>
    <keyword>viewer</keyword>
    <keyword>history</keyword>
    <keyword>snapshot</keyword>
    <keyword>timeline</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <image type="source">https://raw.githubusercontent.com/lutravox/ottersnap/main/docs/images/preview.png</image>
      <caption>Ottersnap image viewer and snapshot timeline</caption>
    </screenshot>
  </screenshots>
  <releases>
