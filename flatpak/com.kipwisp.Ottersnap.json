{
    "app-id": "com.kipwisp.Ottersnap",
    "version": "1.0.0",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.9",
    "sdk": "org.kde.Sdk",
    "finish-args": [
        "--device=dri",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=session-bus",
        "--share=ipc",
        "--talk-name=org.freedesktop.portal.FileChooser",
        "--filesystem=xdg-data/ottersnap:create",
        "--filesystem=home:ro"
    ],
    "command": "ottersnap",
    "modules": [
        {
            "name": "ottersnap",
            "buildsystem": "cmake",
            "build-command": [
                "cmake --build build",
                "install -D docs/metadata/com.kipwisp.Ottersnap.metainfo.xml $FLATPAK_DEST/share/metainfo/com.kipwisp.Ottersnap.metainfo.xml"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                }
            ]
        }
    ]
}
