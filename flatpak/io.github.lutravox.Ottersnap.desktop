[Desktop Entry]
Type=Application
Name=Ottersnap
GenericName=Image Viewer
Comment=View images and keep a timeline of their history
Exec=ottersnap %U
Icon=io.github.lutravox.Ottersnap
Terminal=false
Categories=Graphics;Viewer;Qt;KDE;
MimeType=image/png;image/jpeg;image/gif;image/bmp;image/tiff;image/webp;
Keywords=image;vulkan;snapshot;history;viewer;
StartupNotify=true
