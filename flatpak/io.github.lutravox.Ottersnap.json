{
    "app-id": "io.github.lutravox.Ottersnap",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.9",
    "sdk": "org.kde.Sdk",
    "finish-args": [
        "--device=dri",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--talk-name=org.freedesktop.portal.FileChooser",
        "--filesystem=host",
        "--filesystem=xdg-config/ottersnap:create",
        "--filesystem=xdg-data/ottersnap:create",
        "--filesystem=xdg-cache/ottersnap:create"
    ],
    "command": "ottersnap",
    "modules": [
        {
            "name": "libzip",
            "buildsystem": "cmake",
            "config-opts": [
                "-DBUILD_SHARED_LIBS=ON",
                "-DWITH_BZIP2=OFF",
                "-DWITH_XZ=OFF",
                "-DWITH_ZSTD=OFF",
                "-DWITH_OPENSSL=OFF",
                "-DWITH_MBEDCRYPTO=OFF",
                "-DWITH_LIBCXX=OFF",
                "-DBUILD_REGRESSION=OFF",
                "-DBUILD_EXAMPLES=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://libzip.org/download/libzip-1.11.4.tar.xz",
                    "sha256": "8a247f57d1e3e6f6d11413b12a6f28a9d388de110adc0ec608d893180ed7097b"
                }
            ]
        },
        {
            "name": "ottersnap",
            "buildsystem": "simple",
            "build-commands": [
                "rm -rf build",
                "cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$FLATPAK_DEST",
                "cmake --build build",
                "cmake --install build",
                "install -D docs/metadata/io.github.lutravox.Ottersnap.metainfo.xml $FLATPAK_DEST/share/metainfo/io.github.lutravox.Ottersnap.metainfo.xml",
                "install -D flatpak/io.github.lutravox.Ottersnap.desktop $FLATPAK_DEST/share/applications/io.github.lutravox.Ottersnap.desktop",
                "mkdir -p $FLATPAK_DEST/share/icons/hicolor/scalable/apps",
                "install -D src/resources/icons/ottersnap.svg $FLATPAK_DEST/share/icons/hicolor/scalable/apps/io.github.lutravox.Ottersnap.svg",
                "for pair in 48:48x48 64:64x64 128:128x128 256:256x256 512:512x512; do px=${pair%%:*}; dir=${pair##*:}; mkdir -p $FLATPAK_DEST/share/icons/hicolor/$dir/apps && rsvg-convert -w $px -h $px src/resources/icons/ottersnap.svg -o $FLATPAK_DEST/share/icons/hicolor/$dir/apps/io.github.lutravox.Ottersnap.png; done"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                }
            ]
        }
    ]
}
