#!/usr/bin/env bash
# Pre-commit hook: ensure all staged C/C++ files are clang-format compliant.
#
# Install:
#   cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

# Collect staged C++ files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.(cpp|cxx|cc|c|hpp|hxx|hh|h|cu|h)$' || true)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Check each file against .clang-format
EXIT_CODE=0
for FILE in $STAGED_FILES; do
  if [ ! -f "$FILE" ]; then
    continue
  fi

  if ! clang-format --dry-run --Werror --style=file "$FILE" >/dev/null 2>&1; then
    echo "❌ Formatting issues in $FILE"
    echo "   Fix with: clang-format -i $FILE"
    EXIT_CODE=1
  fi
done

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "Commit blocked: fix the formatting errors above, then re-stage."
  echo "  git add <files>"
  echo ""
  exit 1
fi

exit 0
