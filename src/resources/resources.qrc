<RCC>
    <qresource prefix="/">
        <file alias="qss/snapshottimeline.qss">qss/snapshottimeline.qss</file>
        <file alias="qss/notification.qss">qss/notification.qss</file>
        <file alias="qss/vkimageviewer.qss">qss/vkimageviewer.qss</file>
        <file alias="qss/snapshotmanagerdialog.qss">qss/snapshotmanagerdialog.qss</file>
        <file alias="qss/messagebox.qss">qss/messagebox.qss</file>
        <file alias="qss/statusbar.qss">qss/statusbar.qss</file>
        <file alias="icons/grayscale.svg">icons/grayscale.svg</file>
        <file alias="icons/mirror.svg">icons/mirror.svg</file>
        <file alias="icons/swap.svg">icons/swap.svg</file>
        <file alias="icons/colorpicker.svg">icons/colorpicker.svg</file>
        <file alias="icons/ottersnap.svg">icons/ottersnap.svg</file>
        <file>../ui/qml/notification.qml</file>
        <file>../ui/qml/colorinfo.qml</file>
        <file>shaders/snapshot_reconstruct.comp</file>
        <file>shaders/snapshot_downsample.comp</file>
    </qresource>
</RCC>
