#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) buffer FullImage {
    uint pixelsFull[];
};

layout(set = 0, binding = 1) buffer ThumbImage {
    uint pixelsThumb[];
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint targetW;
    uint targetH;
} pcs;

vec4 unpackRGBA8(uint p) {
    return vec4(
        float((p & 0xFFu) / 255.0),
        float(((p >> 8u) & 0xFFu) / 255.0),
        float(((p >> 16u) & 0xFFu) / 255.0),
        float(((p >> 24u) & 0xFFu) / 255.0)
    );
}

uint packRGBA8(vec4 color) {
    uvec4 c = uvec4(clamp(color * 255.0, 0.0, 255.0));
    return (c.x & 0xFFu) | ((c.y & 0xFFu) << 8u) | ((c.z & 0xFFu) << 16u) | ((c.w & 0xFFu) << 24u);
}

vec4 sampleBilinear(vec2 uv) {
    float x = uv.x * float(pcs.width);
    float y = uv.y * float(pcs.height);

    uint x0 = uint(max(0.0, floor(x)));
    uint y0 = uint(max(0.0, floor(y)));
    uint x1 = uint(min(float(pcs.width - 1), x0 + 1.0));
    uint y1 = uint(min(float(pcs.height - 1), y0 + 1.0));

    float fx = fract(x);
    float fy = fract(y);

    vec4 p00 = unpackRGBA8(pixelsFull[y0 * pcs.width + x0]);
    vec4 p10 = unpackRGBA8(pixelsFull[y0 * pcs.width + x1]);
    vec4 p01 = unpackRGBA8(pixelsFull[y1 * pcs.width + x0]);
    vec4 p11 = unpackRGBA8(pixelsFull[y1 * pcs.width + x1]);

    return mix(mix(p00, p10, fx), mix(p01, p11, fx), fy);
}

void main() {
    uint gx = gl_GlobalInvocationID.x;
    uint gy = gl_GlobalInvocationID.y;

    if (gx >= pcs.targetW || gy >= pcs.targetH) return;

    vec2 uv = vec2(
        (float(gx) + 0.5) / float(pcs.targetW),
        (float(gy) + 0.5) / float(pcs.targetH)
    );

    vec4 color = vec4(0.0);
    const int SAMPLES = 4;
    for (int i = 0; i < SAMPLES; ++i) {
        for (int j = 0; j < SAMPLES; ++j) {
            vec2 offset = vec2(
                (float(i) + 0.5) / float(SAMPLES),
                (float(j) + 0.5) / float(SAMPLES)
            );
            vec2 sampleUV = uv + (offset - 0.5) * vec2(1.0 / float(pcs.targetW), 1.0 / float(pcs.targetH));
            color += sampleBilinear(sampleUV);
        }
    }
    color /= float(SAMPLES * SAMPLES);
    pixelsThumb[gy * pcs.targetW + gx] = packRGBA8(color);
}
